        { name: 'Assignment 1', score: 92, maxScore: 100, weight: 15 },
        { name: 'Assignment 2', score: 88, maxScore: 100, weight: 15 },
        { name: 'Midterm Exam', score: 85, maxScore: 100, weight: 35 },
        { name: 'Final Project', score: null, maxScore: 100, weight: 35 }
      ],
