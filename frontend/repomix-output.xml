                        </Avatar>
                        <div>
                          <h3 className="font-semibold">{student.name}</h3>
                          <p className="text-sm text-gray-500">{student.id}</p>
                        </div>
                      </div>
                      <Badge className={getStatusColor(student.status)}>
                        {student.status.replace('-', ' ')}
