} from 'lucide-react'

export default function StudentGrades() {
  const [selectedSemester, setSelectedSemester] = useState('current')
  const [gpaCalculatorInputs, setGpaCalculatorInputs] = useState([
    { subject: '', credits: '', grade: '' }
  ])

  // Mock data
  const gpaData = {
